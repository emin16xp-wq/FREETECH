{
  "name": "orbit-ai",
  "productName": "Orbit AI",
  "version": "1.0.0",
  "description": "A floating AI assistant button for your desktop — chat powered by Groq, OpenRouter & NVIDIA, with MCP connectors and skills.",
  "main": "main/main.js",
  "author": "Orbit AI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.orbitai.desktop",
    "productName": "Orbit AI",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit AI",
      "artifactName": "OrbitAI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OrbitAI-Portable-${version}.${ext}"
    }
  }
}
